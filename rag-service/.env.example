# DashScope API Key (北京端点，用于 LLM / Embedding / Rerank)
DASHSCOPE_API_KEY=sk-your_dashscope_api_key

# DashScope API Key (新加坡端点，可选；设置后所有模型调用切换至新加坡)
DASHSCOPE_INTL_API_KEY=

# DashVector 配置
DASHVECTOR_API_KEY=your_dashvector_api_key
DASHVECTOR_HOTEL_ENDPOINT=your_dashvector_endpoint

# LangSmith 监控 (可选)
LANGSMITH_API_KEY=

# Insforge 数据库配置 (可选，不配置则自动回退到本地 CSV)
NEXT_PUBLIC_INSFORGE_BASE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# 向量检索引擎 (当前仅支持 dashvector)
VECTOR_SEARCH_ENGINE=dashvector

# Elasticsearch (可选，不配置则使用本地 pickle BM25 索引)
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_INDEX=hotel_comments
